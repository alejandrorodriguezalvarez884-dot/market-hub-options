---
// The chain: an underlying's expirations, one expiration read in detail, and all of them side by side.
import Page from "../components/Page.astro";
import { SITE_NAME, link } from "../lib/site";

const examples = ["SPY", "QQQ", "AAPL", "NVDA", "TSLA", "MSFT"];
---

<Page title={SITE_NAME} description="Option chains read in detail: every call and put with its implied volatility, greeks, breakeven and odds, each expiration as a whole, and the term structure.">
	<h1 class="text-[2rem] font-medium leading-tight tracking-tight text-ink-strong">Options Lab</h1>
	<p class="mt-2 max-w-2xl text-ink">
		Every call and put of a US-listed stock or fund, read one by one and as a whole. Build a strategy from them in
		<a href={link("/strategy/")} data-strategy-link class="link">Strategy</a>.
	</p>
	<form id="find" class="relative mt-6 w-full max-w-md" role="search">
		<label class="sr-only" for="find-input">Ticker or company name</label>
		<div class="flex items-center gap-2 rounded-[3px] border border-line-strong p-1 pl-3 transition focus-within:border-ink-strong">
			<svg class="h-4 w-4 flex-none text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<circle cx="9" cy="9" r="6"></circle>
				<path d="m14 14 4 4" stroke-linecap="round"></path>
			</svg>
			<input id="find-input" type="search" autocomplete="off" spellcheck="false" placeholder="Ticker or company: AAPL, SPY, Tesla…"
				class="min-w-0 flex-1 bg-transparent py-1 text-sm text-ink-strong placeholder:text-faint focus:outline-none [&::-webkit-search-cancel-button]:hidden" />
			<button type="submit" class="btn btn-primary flex-none px-3 py-1.5">Open</button>
		</div>
		<ul class="search-list" role="listbox" hidden></ul>
	</form>

	<div id="empty" class="mt-10" hidden>
		<p class="text-[14px] text-muted">Open a ticker to read its options. For example:</p>
		<div class="mt-3 flex flex-wrap gap-2">
			{examples.map((t) => <a href={`${link("/")}?t=${t}`} data-example={t} class="chip px-2 py-0.5 text-[13px]">{t}</a>)}
		</div>
	</div>

	<div id="head" class="mt-10"></div>
	<div id="expiries" class="relative mt-8 flex gap-1 overflow-x-auto border-b border-line pb-2 [scrollbar-width:thin]" aria-label="Expirations"></div>
	<div id="summary" class="mt-8 scroll-mt-20"></div>
	<div id="charts" class="mt-10 grid gap-10 lg:grid-cols-2"></div>
	<div id="table-wrap" class="mt-10"></div>
	<div id="terms-wrap" class="mt-12"></div>
</Page>

<script>
	import { start } from "../lib/chainview";
	start();
</script>
