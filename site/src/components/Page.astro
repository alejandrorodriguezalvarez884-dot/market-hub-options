---
// Shell shared by every page. The tool is a section of My Hub, the private area of Market Hub:
// the portal's private navigation at the side (HubNav), and above the page the tool's own bar.
import Layout from "../layouts/Layout.astro";
import { AUTHOR_URL, HUB_URL, SITE_NAME, link } from "../lib/site";
import HubNav from "./HubNav.astro";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;

const path = Astro.url.pathname;
const pages = [
	{ href: link("/"), label: "Chain", active: path === link("/") },
	{ href: link("/strategy/"), label: "Strategy", active: path.startsWith(link("/strategy/")) },
	{ href: link("/method/"), label: "Method", active: path.startsWith(link("/method/")) },
];
---

<Layout title={title === SITE_NAME ? `${title} — Market Hub` : `${title} — ${SITE_NAME} — Market Hub`} description={description}>
	<div class="lg:flex">
		<HubNav part="side" />
		<div class="min-w-0 flex-1">
			<HubNav part="top" />
			<header class="top-0 z-40 border-b border-line bg-page/95 backdrop-blur sm:sticky">
				<div class="mx-auto flex h-14 max-w-[1240px] items-center gap-4 px-5 lg:gap-8 lg:px-8">
					<a href={link("/")} class="flex-none whitespace-nowrap text-[15px] font-semibold tracking-tight text-ink-strong">{SITE_NAME}</a>
					<nav aria-label={SITE_NAME}>
						<ul class="flex items-center gap-5 text-sm">
							{pages.map((l) => (
								<li><a href={l.href} aria-current={l.active ? "page" : undefined}
									class:list={["border-b py-1 transition-colors hover:text-ink-strong", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a></li>
							))}
						</ul>
					</nav>
				</div>
			</header>
			<main class="mx-auto max-w-[1240px] px-5 pb-24 pt-8 sm:pt-12 lg:px-8">
				<slot />
			</main>
			<footer class="border-t border-line">
				<div class="mx-auto grid max-w-[1240px] gap-6 px-5 py-8 text-[13px] text-muted md:grid-cols-[1fr_auto] lg:px-8">
					<p class="max-w-2xl">
						Figures are computed from option prices that can be delayed or contain errors. Odds are the ones those prices
						imply, not a forecast, and a strategy shown here is one the visitor built, not a suggestion. Nothing here is
						investment advice or a recommendation to buy or sell anything.{" "}
						<a href={link("/method/")} class="link">Sources and method</a>.
					</p>
					<div class="flex flex-wrap items-start gap-x-5 gap-y-1">
						<a href={`${HUB_URL}/privacy/`} class="hover:text-ink-strong">Privacy</a>
						<a href={AUTHOR_URL} class="hover:text-ink-strong">Built by Alejandro Rodríguez Álvarez</a>
					</div>
				</div>
			</footer>
		</div>
	</div>
</Layout>
