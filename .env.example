# Copy to .env and fill in. .env is ignored by git: never commit keys.
# Nothing here is a paid key: chains, prices and the Treasury bill rate come from Yahoo Finance
# (the yfinance library), which takes none.

# Market Hub: with its address set, only people signed in there can use the tool (the hub's
# session secret comes from Secret Manager on deploy; locally set HUB_SESSION_SECRET too).
HUB_URL=https://themarkethub.app
